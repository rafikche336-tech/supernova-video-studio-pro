# ---------------------------------------------------------------------------
# Supernova Video Studio — environment variables
# Copy to `.env.local` and adjust. `.env*` files are git-ignored.
# Every variable is validated in lib/env.ts; an invalid value fails fast.
#
# To use real text-to-video AI, set ONE provider key below and leave
# RENDER_PROVIDER=auto. With no key, the app runs in demo mode.
# Step-by-step instructions: README.md → "Turn on real video generation".
# ---------------------------------------------------------------------------

# ------------------------------------------------------- render provider
# Which backend turns prompts into video.
#
#   auto      = use fal.ai, else Replicate, else demo (default, recommended)
#   fal       = force fal.ai (raises an error if FAL_KEY is missing)
#   replicate = force Replicate (raises an error if REPLICATE_API_TOKEN is missing)
#   demo      = never call a paid API; always render a bundled clip
#
# With `auto`, if the live provider fails on a single job (out of credit,
# network error, provider outage) that job is rendered in demo mode instead and
# is labelled as such. Set `demo` to switch every call off without touching keys.
RENDER_PROVIDER=auto

# --------------------------------------------------------------- fal.ai
# Cheapest option: ~$0.05/second of 480p video (a 5 s clip ≈ $0.25).
# New accounts get $10 of credit, i.e. roughly 20–100 clips to try it out.
# 1. Sign up at https://fal.ai
# 2. Open https://fal.ai/dashboard/keys and create a key (shape: `xxxx:yyyy`)
# 3. Paste it below and restart the dev server.
FAL_KEY=
# Any fal video model id works. Defaults to a fast, cheap LTX-2 text-to-video.
# Browse models: https://fal.ai/models?categories=text-to-video
FAL_VIDEO_MODEL=fal-ai/ltx-2/text-to-video/fast
# Only override for a proxy/self-hosted gateway.
# FAL_API_BASE_URL=https://queue.fal.run

# ------------------------------------------------------------- Replicate
# Pay-as-you-go alternative, ~$0.09/second at 480p. Used automatically when
# FAL_KEY is empty and RENDER_PROVIDER=auto.
# 1. Sign up at https://replicate.com
# 2. Copy the token from https://replicate.com/account/api-tokens (starts `r8_`)
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=lightricks/ltx-video
# REPLICATE_API_BASE_URL=https://api.replicate.com

# --------------------------------------------------------- video options
# Requested clip length in seconds. Shorter is cheaper: cost scales with it.
VIDEO_DURATION_SECONDS=5
# 16:9 (landscape), 9:16 (vertical) or 1:1.
VIDEO_ASPECT_RATIO=16:9

# ------------------------------------------------------------ media store
# Where generated MP4s are written and served from. `data/` is git-ignored.
# In production this MUST live on a persistent, writable volume that survives
# redeploys, or history thumbnails and videos will 404 after a restart.
MEDIA_DIR=data/videos
# Refuse (and fail the job) above this size. 67108864 = 64 MB.
VIDEO_MAX_BYTES=67108864

# Canonical URL used for metadata, Open Graph, sitemap, robots and share links.
# Use the real production origin when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------------------------------------------------------------- auth
# Signs session cookies. REQUIRED IN PRODUCTION — sign-in fails without it.
# Generate one with: openssl rand -base64 32
# In development a throwaway default is used so `npm run dev` just works.
# AUTH_SECRET=

# GitHub OAuth app (https://github.com/settings/developers).
# Callback URL: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/github
# Both values must be present to enable the provider; otherwise the login page
# offers guest access only.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# ----------------------------------------------------------------- database
# SQLite file, relative to the project root (or an absolute path).
# Point this at a persistent volume when deploying — the whole render history
# lives here. Use `:memory:` for throwaway test runs.
DATABASE_PATH=data/supernova.db

# ------------------------------------------------------------ rate limiting
# Per-client token bucket on POST /api/render (keyed by user id when signed in).
# Keep this tight when a paid provider is active: every accepted request can
# cost real money.
RATE_LIMIT_CAPACITY=12
RATE_LIMIT_REFILL_PER_SECOND=0.2
