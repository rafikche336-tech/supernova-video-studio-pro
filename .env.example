# ---------------------------------------------------------------------------
# Supernova Video Studio — environment variables
# Copy to `.env.local` and adjust. `.env*` files are git-ignored.
# Every variable is validated in lib/env.ts; an invalid value fails fast.
# ---------------------------------------------------------------------------

# Render backend.
#   demo = procedurally generated clips, no model/GPU/API key required (default)
#   live = your own inference backend (not implemented yet — see docs/ARCHITECTURE.md)
RENDER_PROVIDER=demo

# Only required when RENDER_PROVIDER=live.
# RENDER_API_URL=https://api.example.com/render
# RENDER_API_KEY=sk_live_...

# Canonical URL used for metadata, Open Graph, sitemap and robots.
# Use the real production origin when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Per-client request budget (token bucket).
RATE_LIMIT_CAPACITY=12
RATE_LIMIT_REFILL_PER_SECOND=0.2
